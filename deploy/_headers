# Response headers (Netlify and Cloudflare Pages read this file). Every rule
# that matches a path applies.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=()

# The editor: only its own files run. Media, fonts and pictures made in the
# browser (blob: and data: URLs) are allowed. Nothing is sent anywhere else.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Built files have a content hash in their name, so they never change.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers must always check for a new service worker and app page.
/app/sw.js
  Cache-Control: no-cache
/app/
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache
