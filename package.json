{
  "name": "motion",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "pnpm --filter landing dev",
    "dev:editor": "pnpm --filter editor dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/serve-site.mjs",
    "deploy:site": "pnpm build:site && npx netlify-cli deploy --dir=\"$PWD/site\" --filter landing --prod"
  },
  "devDependencies": {
    "turbo": "2.11.11"
  },
  "packageManager": "pnpm@10.25.0"
}
